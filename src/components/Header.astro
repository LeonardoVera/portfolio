---
import iconLogo from '../assets/logoWhite.png?url';
import './Header.css';
---
<div id="header-sentinel" aria-hidden="true" style="position:absolute;top:0;left:0;width:10px;height:10px;pointer-events:none"></div>
<header class="site-header">
  <div class="header-inner shell">
    <a class="brand" href="#home" aria-label="Leonardo Vera, inicio">
      <img src={iconLogo} alt="" width="56" height="56" />
    </a>
    <nav class="nav-bar" aria-label="Navegación principal">
      <a href="#projects">Proyectos</a>
      <a href="#experience">Experiencia</a>
      <a href="#education">Educación</a>
      <a href="#publications">Publicaciones</a>
      <a href="#contact">Contacto</a>
    </nav>
  </div>
</header>

<script>
  const sentinel = document.querySelector('#header-sentinel');
  const header = document.querySelector('.site-header');
  if (sentinel && header) {
    new IntersectionObserver(([entry]) => {
      if (entry) header.classList.toggle('scrolled', !entry.isIntersecting);
    }).observe(sentinel);
  }
</script>
