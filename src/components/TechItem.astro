---
import './TechItem.css'


interface Props { icon: string; name: string; }
const { icon, name } = Astro.props;
---
<div class="tech-item-container" data-reveal>
      <img loading="lazy" width="56" height="56" class:list={['tech-item-img', { 'tech-item-img-inverted': name === 'Next.js' }]} src={icon} alt="" />
      <h3>{name}</h3>
    </div>
