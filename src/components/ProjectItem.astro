---
import './ProjectItem.css';
import attachIcon from '../assets/attach.svg?url';
import githubIcon from '../assets/techIcons/github.svg?url';
interface Props {
  preview: string;
  title: string;
  githubLink?: string;
  liveLink?: string;
  description: string;
}
const { preview, title, githubLink, liveLink, description } = Astro.props;
---
<article class="project-item-container">
  <a class="project-image-wrapper project-preview-clickable" href={preview} data-preview aria-label={`Ampliar imagen de ${title}`}>
    <img src={preview} alt={`Vista previa de ${title}`} loading="lazy" decoding="async" />
  </a>
  <div class="project-item-description">
    <div class="item-desc-header">
      <h3>{title}</h3>
      <div class="project-links">
        {liveLink && <a href={liveLink} target="_blank" rel="noopener noreferrer" class="project-link live-link" aria-label={`Visitar ${title}`}><img src={attachIcon} alt="" width="18" height="18" /></a>}
        {githubLink && <a href={githubLink} target="_blank" rel="noopener noreferrer" class="project-link github-link" aria-label={`Ver código de ${title} en GitHub`}><img src={githubIcon} alt="" width="18" height="18" /></a>}
      </div>
    </div>
    <p class="item-desc-text">{description}</p>
  </div>
</article>
<dialog class="project-image-modal" aria-label={`Imagen de ${title}`}>
  <div class="modal-content">
    <button type="button" class="modal-close-btn" aria-label="Cerrar imagen">&times;</button>
    <img src={preview} alt={`Vista ampliada de ${title}`} loading="lazy" />
  </div>
</dialog>
<script>
  document.querySelectorAll<HTMLAnchorElement>('[data-preview]').forEach((link) => {
    const dialog = link.closest('article')?.nextElementSibling;
    if (!(dialog instanceof HTMLDialogElement)) return;
    let previousOverflow = '';
    link.addEventListener('click', (event) => {
      event.preventDefault();
      previousOverflow = document.body.style.overflow;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    });
    dialog.querySelector('button')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      document.body.style.overflow = previousOverflow;
    });
  });
</script>
